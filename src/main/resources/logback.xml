<?xml version="1.0" encoding="UTF-8"?>
<configuration status="DEBUG">
    <!-- Указываем путь для логов -->
    <property name="LOG_PATH" value="logs" />

    <!-- Аппендер для вывода в консоль -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%-5level] [%t] %c{1} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Аппендер для записи в файл с ротацией -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/back.log</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%-5level] [%t] %c{1} - %msg%n</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/archive/back.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>200MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap> <!-- Ограничение на общий размер логов -->
        </rollingPolicy>
    </appender>

    <!-- Настройки логгеров -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
    </root>

    <!-- Логи для вашего приложения -->
    <logger name="com.usareboot.back" level="DEBUG">
        <appender-ref ref="FILE" />
    </logger>

    <!-- Логи Spring Framework -->
    <logger name="org.springframework" level="INFO" />
    <logger name="org.springframework.web.filter.CommonsRequestLoggingFilter" level="DEBUG" />
    <logger name="org.springframework.web" level="DEBUG" />

    <!-- Логи VK API SDK -->
    <logger name="com.vk.api.sdk" level="DEBUG" />

    <!-- Логи Apache HTTP Client -->
    <logger name="org.apache.http" level="WARN" />
    <logger name="org.apache.http.wire" level="ERROR" />
</configuration>
